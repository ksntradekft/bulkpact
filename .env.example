# BulkPact 1.2.0

# Supabase — required for auth and persistent data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional HU/EN translation for user-generated Group Order content
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Automated Group Order follow-ups
CRON_SECRET=

# Optional transactional e-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=BulkPact
MAIL_FROM_EMAIL=
BUSINESS_INTRO=BulkPact is a European B2B group-buying platform that combines demand from independent businesses to reach supplier minimum order quantities.

# Public deployment URL
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPPORT_EMAIL=
